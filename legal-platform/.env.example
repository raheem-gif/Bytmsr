# انسخ هذا الملف إلى .env وعدّل القيم:  cp .env.example .env
# كل المتغيرات اختيارية في الوضع التجريبي. للتشغيل الفعلي راجع DEPLOY.md و«قائمة التحقق قبل الإطلاق».
# قيمة متغير البيئة تتقدم دائمًا على ما يُحفظ من لوحة الإدارة (صفحة «التكاملات»).

# ===================== التشغيل =====================
# production: يطفئ البيانات التجريبية، ويعمل «وضع الإعداد الأول» عند قاعدة بيانات فارغة
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# 1 = بيانات وحسابات تجريبية + محاكي واتساب (افتراضيًا مفعّل خارج الإنتاج). اجعله 0 في التشغيل الفعلي
DEMO=0
# مجلد البيانات: قاعدة SQLite + المرفقات + النسخ الاحتياطية + مفتاح التشفير (احفظه في نسخ احتياطية!)
DATA_DIR=data
# مسار قاعدة البيانات (اختياري؛ الافتراضي DATA_DIR/platform.db)
DB_PATH=
# الرابط العام للمنصة بـ https (روابط بوابة المستفيد، رابط Webhook، والكعكات الآمنة)
# مثال: PUBLIC_BASE_URL=https://legal.beyootmisr.org
# (على Render إن تُرك فارغًا يُستخدم RENDER_EXTERNAL_URL الذي يضبطه Render تلقائيًا)
PUBLIC_BASE_URL=
# الكعكات الآمنة (Secure): تُفعَّل تلقائيًا عندما يبدأ PUBLIC_BASE_URL بـ https. اضبطها 1 أو 0 لفرض قيمة
COOKIE_SECURE=
# ضع 1 فقط إذا كانت المنصة خلف وكيل عكسي موثوق (Caddy / Nginx / Render) يضيف X-Forwarded-For.
# لا تفعّله عند كشف المنفذ مباشرة (مثل docker run -p 3000:3000) وإلا أمكن تزوير عنوان IP وتجاوز حدود المعدل.
TRUST_PROXY=1
# عدد الوكلاء الموثوقين المتتابعين أمام المنصة (مثال: CDN ثم Caddy = 2). يُقرأ العنوان من يمين X-Forwarded-For
TRUST_PROXY_HOPS=1

# ===================== التشفير =====================
# مفتاح تشفير أسرار التكاملات المحفوظة من لوحة الإدارة (32 حرفًا عشوائيًا على الأقل).
# بدونه يُنشأ الملف DATA_DIR/.secret-key تلقائيًا (احفظه مع النسخ الاحتياطية). لا تغيّره بعد حفظ الأسرار.
# لتوليد قيمة:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# ===================== حساب مدير النظام الأول (اختياري) =====================
# اتركهما فارغين لاستخدام «معالج الإعداد الأول» (/setup) — الرابط يظهر في سجل التشغيل عند أول بدء.
# إن ضُبطا يُنشأ الحساب منهما عند أول تشغيل فقط؛ احذفهما من الملف بعد ذلك.
# استرداد الحساب لاحقًا:  npm run admin -- --username <user>
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===================== الجلسات والحدود =====================
# مهلة عدم النشاط (12 ساعة) والحد الأقصى لعمر الجلسة (72 ساعة) تُضبطان من «الإعدادات › سياسة الأمان».
# ضبط SESSION_TTL_HOURS هنا يفرض عمرًا ثابتًا للجلسة من الخادم ويعطّل هذين الإعدادين في لوحة الإدارة.
# SESSION_TTL_HOURS=12
# صلاحية روابط بوابة المستفيد (أيام)
PORTAL_TOKEN_DAYS=180
# الحد الأقصى لحجم الملف المرفوع (ميجابايت)
MAX_UPLOAD_MB=8
# الحد الأقصى لطلبات الموقع من نفس عنوان IP في الساعة
PUBLIC_INTAKE_PER_HOUR=20
# فاصل المجدول بالثواني (الأتمتة، إعادة إرسال الرسائل، النسخ الاحتياطي اليومي). 0 = متوقف
SCHEDULER_INTERVAL_SECONDS=60

# ===================== WhatsApp Business Platform (Cloud API) =====================
# يُفضّل إدخالها من صفحة «التكاملات» داخل المنصة (تُحفظ مشفرة). بدونها تعمل المنصة في «وضع المحاكاة».
# رمز وصول دائم من System User (صلاحيتا whatsapp_business_messaging و whatsapp_business_management)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# نص سري تختاره وتكتبه أيضًا في إعدادات Webhook على منصة ميتا
WHATSAPP_VERIFY_TOKEN=
# App Secret من إعدادات تطبيق ميتا — للتحقق من توقيع كل Webhook (إلزامي في الإنتاج)
WHATSAPP_APP_SECRET=
# إصدار Graph API (الافتراضي v21.0). اتركه فارغًا ليبقى قابلًا للتعديل من صفحة «التكاملات»
WHATSAPP_API_VERSION=
# رقم واتساب المؤسسة بصيغة دولية أرقامًا فقط (لروابط wa.me في الموقع)، مثل 201211114662
WHATSAPP_NUMBER=

# ===================== الذكاء الاصطناعي (Claude) =====================
# القيم الفارغة تعني «الافتراضي» وتبقى قابلة للتعديل من صفحة «التكاملات»؛ أي قيمة هنا تتقدم على ما في اللوحة.
# auto (الافتراضي): Claude إذا وُجد المفتاح وإلا المحلل المحلي. heuristic: المحلي دائمًا. anthropic: Claude
AI_PROVIDER=
# من console.anthropic.com ← API Keys (يبدأ بـ sk-ant-). يُفضّل إدخاله من صفحة «التكاملات» بدلًا من هنا
ANTHROPIC_API_KEY=
# الافتراضي claude-opus-5-5
AI_MODEL=
# low | medium (الافتراضي) | high | xhigh | max
AI_EFFORT=
# سقف الإنفاق الشهري بالدولار (0 = بلا سقف)
AI_MONTHLY_BUDGET_USD=
