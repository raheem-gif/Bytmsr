# انسخ هذا الملف إلى .env وعدّل القيم. كل المتغيرات اختيارية في الوضع التجريبي.

# ===== التشغيل =====
# production يُطفئ البيانات التجريبية ويتطلب ADMIN_USERNAME و ADMIN_PASSWORD عند أول تشغيل
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# 1 = بيانات وحسابات تجريبية + محاكي واتساب (افتراضيًا مفعّل خارج الإنتاج)
DEMO=1
# مجلد قاعدة البيانات والمرفقات (احفظه في نسخ احتياطية!)
DATA_DIR=data
# الرابط العام للمنصة (يُستخدم في روابط بوابة العميل). مع https تُفعَّل الكعكات الآمنة تلقائيًا
PUBLIC_BASE_URL=
# ضع 1 فقط إذا كانت المنصة خلف وكيل عكسي موثوق (Nginx / منصة استضافة) يضيف X-Forwarded-For.
# لا تفعّله عند تشغيل المنصة مكشوفة مباشرة (مثل docker run -p 3000:3000) وإلا أمكن تزوير عنوان IP وتجاوز حدود المعدل.
TRUST_PROXY=0
# عدد الوكلاء الموثوقين المتتابعين أمام المنصة (مثال: CDN ثم Nginx = 2). يُقرأ العنوان من يمين X-Forwarded-For.
TRUST_PROXY_HOPS=1

# ===== حساب مدير النظام الأول (وضع الإنتاج فقط) =====
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== الجلسات والحدود =====
SESSION_TTL_HOURS=12
PORTAL_TOKEN_DAYS=180
MAX_UPLOAD_MB=8
PUBLIC_INTAKE_PER_HOUR=20
SCHEDULER_INTERVAL_SECONDS=60

# ===== WhatsApp Business Platform (Cloud API) =====
# بدون هذه القيم تعمل المنصة في «وضع المحاكاة»: تُسجَّل الرسائل الصادرة دون إرسال فعلي
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# أي نص سري تختاره وتكتبه أيضًا في إعدادات Webhook على منصة ميتا
WHATSAPP_VERIFY_TOKEN=
# App Secret من إعدادات تطبيق ميتا — للتحقق من توقيع كل Webhook (مهم في الإنتاج)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# رقم واتساب المؤسسة بصيغة دولية أرقامًا فقط (لروابط wa.me في الموقع)، مثل 201000000000
WHATSAPP_NUMBER=

# ===== الذكاء الاصطناعي =====
# auto: يستخدم Claude إذا وُجد المفتاح، وإلا المحلل المحلي. heuristic: المحلي دائمًا. anthropic: Claude
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
