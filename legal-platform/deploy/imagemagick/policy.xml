<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
<!ELEMENT policymap (policy)*>
<!ATTLIST policymap xmlns CDATA #FIXED "">
<!ELEMENT policy EMPTY>
<!ATTLIST policy xmlns CDATA #FIXED "">
<!ATTLIST policy domain NMTOKEN #REQUIRED>
<!ATTLIST policy name NMTOKEN #IMPLIED>
<!ATTLIST policy pattern CDATA #IMPLIED>
<!ATTLIST policy rights NMTOKEN #IMPLIED>
<!ATTLIST policy stealth NMTOKEN #IMPLIED>
<!ATTLIST policy value CDATA #IMPLIED>
]>
<!--
  v12 media, L12-68: the ImageMagick policy the platform runs with.
  Both Dockerfiles copy this file to /etc/ImageMagick-6/policy.xml, and every spawn also points
  MAGICK_CONFIGURE_PATH at this folder. ImageMagick 6.9 reads policy.xml only from its system folder, so on a
  server without Docker copy this file there by hand. src/media-tools.js refuses to use ImageMagick, it fails
  closed, unless convert -list policy shows the deny-all coder rule below.
  The platform only asks ImageMagick to read JPEG, PNG or WebP photos, with the coder prefix taken from the
  verified MIME type, and to write raw RGBA or GRAY pixels or a JPEG. Every other coder, every delegate,
  every filter and indirect file lists are denied.
-->
<policymap>
  <policy domain="resource" name="memory" value="48MiB"/>
  <policy domain="resource" name="map" value="96MiB"/>
  <policy domain="resource" name="disk" value="512MiB"/>
  <policy domain="resource" name="area" value="40MP"/>
  <policy domain="resource" name="width" value="12KP"/>
  <policy domain="resource" name="height" value="12KP"/>
  <policy domain="resource" name="list-length" value="4"/>
  <policy domain="resource" name="thread" value="1"/>
  <policy domain="resource" name="time" value="60"/>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="path" rights="none" pattern="@*"/>
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read | write" pattern="{JPEG,JPG,PNG,WEBP,RGBA,GRAY}"/>
  <policy domain="module" rights="none" pattern="{MSL,MVG,PS,PDF,SVG,URL,XPS,TEXT,EPHEMERAL,HTML}"/>
</policymap>
